{% style %}
  :root {
    --font-heading-family: 'Archivo', sans-serif;
    --font-body-family: 'Inter', sans-serif;
    --font-heading: var(--font-heading-family);
    --font-body: var(--font-body-family);
    --font-primary--family: var(--font-body-family);
    --font-primary--style: normal;
    --font-primary--weight: 400;
    --page-width: {{ settings.max_page_width | default: '110rem' }};
    --page-margin: {{ settings.min_page_margin | default: 20 }}px;
    --color-background: {{ settings.background_color | default: '#F5F6F8' }};
    --color-foreground: {{ settings.foreground_color | default: '#0B0B0C' }};
    --color-subtext: {{ settings.subtext_color | default: '#61666D' }};
    --color-accent-blue: {{ settings.accent_blue | default: '#1E90FF' }};
    --color-accent-yellow: {{ settings.accent_yellow | default: '#FFD400' }};
    --radius-card: {{ settings.card_corner_radius | default: 32 }}px;
    --radius-pill: {{ settings.button_corner_radius | default: 999 }}px;
    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 8 }}px;
  }
{% endstyle %}
