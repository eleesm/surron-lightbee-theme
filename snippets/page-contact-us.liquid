{% doc %}
  Renders the complete Contact Us content for Bike Bee.
  Designed to be embedded within .page__content inside .page__container.
{% enddoc %}

<p>
  We're here to help! Whether you have questions about the 2026 Sur-Ron Light Bee X, need support with an existing order, or need technical assistance, our California team is ready to assist you.
</p>

<div class="page-grid">
  <div class="page-card">
    <h3>📧 Email Us</h3>
    <p>Best for pre-sale questions, order status, and technical inquiries.</p>
    <p style="margin-top: 0.5rem;"><a href="mailto:contact@bikebee.shop" style="font-weight: 700;">contact@bikebee.shop</a></p>
    <p style="font-size: 0.85rem; color: #1E90FF; margin-top: 0.25rem;">Response time: Within 24 hours</p>
  </div>

  <div class="page-card">
    <h3>📍 Visit Us</h3>
    <p><strong>Bike Bee Headquarters</strong></p>
    <p>430 W Ventura St<br>Dinuba, CA 93618<br>United States</p>
    <p style="font-size: 0.82rem; color: #61666D; margin-top: 0.25rem;">* Visits by appointment only</p>
  </div>

  <div class="page-card">
    <h3>🕐 Business Hours</h3>
    <p><strong>Monday – Friday:</strong> 9:00 AM – 6:00 PM PST<br>
    <strong>Saturday:</strong> 10:00 AM – 4:00 PM PST<br>
    <strong>Sunday:</strong> Closed</p>
  </div>
</div>

<h2>Send Us a Message</h2>
<p>Complete the form below and we will get back to you within 24 hours.</p>

<div class="contact-highlight-box">
  {% form 'contact', id: 'ContactPageForm', class: 'contact-page-form' %}
    {% if form.posted_successfully? %}
      <div style="background: #E8F5E9; border: 1px solid #A5D6A7; color: #2E7D32; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
        <strong>Thank you!</strong> Your message has been sent successfully. We will get back to you within 24 hours.
      </div>
    {% endif %}

    {% if form.errors %}
      <div style="background: #FFEBEE; border: 1px solid #FFCDD2; color: #C62828; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
        <strong>Please check your input:</strong>
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
      <div>
        <label for="ContactFormName" style="display: block; font-weight: 600; margin-bottom: 0.35rem;">Full Name *</label>
        <input type="text" id="ContactFormName" name="contact[name]" required placeholder="John Doe" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid rgba(11,11,12,0.15); border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;">
      </div>

      <div>
        <label for="ContactFormEmail" style="display: block; font-weight: 600; margin-bottom: 0.35rem;">Email Address *</label>
        <input type="email" id="ContactFormEmail" name="contact[email]" required placeholder="john@example.com" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid rgba(11,11,12,0.15); border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;">
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
      <div>
        <label for="ContactFormOrder" style="display: block; font-weight: 600; margin-bottom: 0.35rem;">Order Number (Optional)</label>
        <input type="text" id="ContactFormOrder" name="contact[order_number]" placeholder="e.g. BB-12345" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid rgba(11,11,12,0.15); border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;">
      </div>

      <div>
        <label for="ContactFormSubject" style="display: block; font-weight: 600; margin-bottom: 0.35rem;">Subject *</label>
        <select id="ContactFormSubject" name="contact[subject]" required style="width: 100%; padding: 0.75rem 1rem; border: 1px solid rgba(11,11,12,0.15); border-radius: 8px; font-size: 0.95rem; box-sizing: border-box; background: white;">
          <option value="" disabled selected>Select a subject...</option>
          <option value="Pre-Sale Question">Pre-Sale Question</option>
          <option value="Order Status">Order Status</option>
          <option value="Shipping Inquiry">Shipping Inquiry</option>
          <option value="Return or Exchange">Return or Exchange</option>
          <option value="Warranty Claim">Warranty Claim</option>
          <option value="Technical Support">Technical Support</option>
          <option value="Other">Other</option>
        </select>
      </div>
    </div>

    <div style="margin-bottom: 1.5rem;">
      <label for="ContactFormMessage" style="display: block; font-weight: 600; margin-bottom: 0.35rem;">Message *</label>
      <textarea id="ContactFormMessage" name="contact[body]" rows="5" required placeholder="How can we help you?" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid rgba(11,11,12,0.15); border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;"></textarea>
    </div>

    <button type="submit" class="page-btn page-btn--primary" style="width: 100%;">Send Message</button>
  {% endform %}
</div>

<h2>Quick Support Links</h2>
<div class="page-grid">
  <div class="page-card">
    <h3>📦 Track Your Order</h3>
    <p>Check the status of your shipment.</p>
    <p style="margin-top: 0.5rem;"><a href="/pages/shipping-policy">Shipping & Tracking Info →</a></p>
  </div>
  <div class="page-card">
    <h3>❓ FAQ</h3>
    <p>Find answers to common questions.</p>
    <p style="margin-top: 0.5rem;"><a href="/pages/faq">View All FAQs →</a></p>
  </div>
  <div class="page-card">
    <h3>🔄 Returns</h3>
    <p>Learn about our 30-day money-back guarantee.</p>
    <p style="margin-top: 0.5rem;"><a href="/pages/refund-policy">Return Policy →</a></p>
  </div>
  <div class="page-card">
    <h3>🛡️ 100-Day Warranty</h3>
    <p>Read about motor and battery coverage.</p>
    <p style="margin-top: 0.5rem;"><a href="/pages/refund-policy#warranty">Warranty Info →</a></p>
  </div>
</div>

<h2>Common Questions</h2>
<div class="faq-detail">
  <div class="faq-summary">How long does shipping take?</div>
  <div class="faq-answer">We offer free 7-day shipping to all 50 USA states. Orders are processed within 24–48 hours.</div>
</div>

<div class="faq-detail">
  <div class="faq-summary">Is the Light Bee street legal?</div>
  <div class="faq-answer">No, the Sur-Ron Light Bee X is designed strictly for off-road use only. It is not street legal in most states.</div>
</div>

<div class="faq-detail">
  <div class="faq-summary">What warranty do you offer?</div>
  <div class="faq-answer">All bikes come with a 100-day warranty covering motor and battery defects.</div>
</div>

<div class="faq-detail">
  <div class="faq-summary">Do you offer financing?</div>
  <div class="faq-answer">Yes! We offer financing options through Shop Pay at checkout.</div>
</div>

<div class="legal-notice-banner" style="margin-top: 2rem;">
  <h3>🚨 Emergency / Urgent Order Issues</h3>
  <p>For urgent order issues or delivery problems, email <a href="mailto:contact@bikebee.shop?subject=URGENT">contact@bikebee.shop</a> with "URGENT" in the subject line, and we will prioritize your request.</p>
</div>

<div class="page-disclaimer">
  <p>This document is for informational purposes and does not constitute legal advice. &copy; {{ 'now' | date: '%Y' }} Bike Bee. All rights reserved.</p>
</div>
