{% doc %}
  Renders the complete Contact Us page for Bike Bee.
  Features direct contact cards, interactive native Shopify contact form,
  quick support links, common question accordion, and California business hours.
{% enddoc %}

<article class="page-wrapper">
  <div class="page-container page-container--wide">
    <header class="page-header">
      <span class="page-eyebrow">💬 WE'RE HERE TO HELP</span>
      <h1 class="page-title">Contact Us</h1>
      <p class="page-subtitle">Have questions about the 2026 Sur-Ron Light Bee X, order status, or technical setup? Our California team is standing by.</p>
    </header>

    <div class="page-container">
      <!-- Contact Channels Grid -->
      <section class="content-section">
        <div class="page-grid">
          <div class="page-card">
            <div class="page-card__icon">📧</div>
            <h3>Email Support</h3>
            <p>Best for pre-sale questions, order updates, and technical inquiries.</p>
            <p style="margin-top: 0.75rem;">
              <a href="mailto:contact@bikebee.shop" style="font-weight: 700;">contact@bikebee.shop</a>
            </p>
            <p style="font-size: 0.8rem; color: #1E90FF; margin-top: 0.25rem;">⚡ Response within 24 hours</p>
          </div>

          <div class="page-card">
            <div class="page-card__icon">📍</div>
            <h3>Headquarters</h3>
            <p><strong>Bike Bee</strong></p>
            <p>430 W Ventura St<br>Dinuba, CA 93618<br>United States</p>
            <p style="font-size: 0.8rem; color: var(--color-subtext); margin-top: 0.25rem;">* Facility visits by appointment only</p>
          </div>

          <div class="page-card">
            <div class="page-card__icon">🕒</div>
            <h3>Business Hours</h3>
            <p><strong>Monday – Friday:</strong> 9:00 AM – 6:00 PM PST</p>
            <p><strong>Saturday:</strong> 10:00 AM – 4:00 PM PST</p>
            <p><strong>Sunday:</strong> Closed (Trail Riding)</p>
          </div>
        </div>
      </section>

      <!-- Native Shopify Contact Form -->
      <section class="content-section">
        <h2>Send Us a Message</h2>
        <p>Fill out the form below and our team will get back to you with comprehensive answers within 24 hours.</p>

        <div class="contact-form-container">
          {% form 'contact', id: 'ContactPageForm', class: 'contact-page-form' %}
            {% if form.posted_successfully? %}
              <div class="form-message form-message--success">
                <strong>Thank you!</strong> Your message has been sent successfully. Our support team will review your inquiry and get back to you within 24 hours.
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="form-message form-message--error">
                <strong>Please check your submission:</strong>
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="contact-form-grid">
              <div class="form-group">
                <label for="ContactFormName" class="form-label">Full Name <span>*</span></label>
                <input
                  type="text"
                  id="ContactFormName"
                  name="contact[name]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  class="form-input"
                  placeholder="e.g. Alex Johnson"
                  required
                >
              </div>

              <div class="form-group">
                <label for="ContactFormEmail" class="form-label">Email Address <span>*</span></label>
                <input
                  type="email"
                  id="ContactFormEmail"
                  name="contact[email]"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  class="form-input"
                  placeholder="alex@example.com"
                  spellcheck="false"
                  autocomplete="email"
                  autocapitalize="off"
                  required
                >
              </div>

              <div class="form-group">
                <label for="ContactFormOrder" class="form-label">Order Number (Optional)</label>
                <input
                  type="text"
                  id="ContactFormOrder"
                  name="contact[order_number]"
                  class="form-input"
                  placeholder="e.g. #BB-1024"
                >
                <span class="form-hint">Found in your email confirmation</span>
              </div>

              <div class="form-group">
                <label for="ContactFormSubject" class="form-label">Inquiry Subject <span>*</span></label>
                <select id="ContactFormSubject" name="contact[subject]" class="form-select" required>
                  <option value="" disabled selected>Select topic...</option>
                  <option value="Pre-Sale Question">Pre-Sale & Specifications</option>
                  <option value="Order Status / Tracking">Order Status & Tracking</option>
                  <option value="Shipping / Freight Inquiry">Shipping & Freight Inquiries</option>
                  <option value="Return / Refund Request">Return or Refund Request</option>
                  <option value="Warranty Claim">100-Day Warranty Claim</option>
                  <option value="Technical Support">Assembly & Technical Support</option>
                  <option value="Other">Other Inquiry</option>
                </select>
              </div>

              <div class="form-group form-group--full">
                <label for="ContactFormMessage" class="form-label">Message Details <span>*</span></label>
                <textarea
                  id="ContactFormMessage"
                  name="contact[body]"
                  rows="6"
                  class="form-textarea"
                  placeholder="Please describe how we can assist you. Include any model specifications, symptoms, or order details..."
                  required
                >{% if form.body %}{{ form.body }}{% endif %}</textarea>
              </div>

              <div class="form-group form-group--full">
                <button type="submit" class="page-btn page-btn--primary page-btn--full">
                  Submit Message
                </button>
              </div>
            </div>
          {% endform %}
        </div>
      </section>

      <!-- Quick Support Links -->
      <section class="content-section">
        <h2>Quick Self-Service Links</h2>
        <div class="page-grid">
          <div class="page-card">
            <h3>📦 Order Tracking</h3>
            <p>Track your shipment status with real-time milestones.</p>
            <p style="margin-top: 0.5rem;"><a href="/pages/shipping-policy#tracking">View Shipping & Tracking →</a></p>
          </div>
          <div class="page-card">
            <h3>❓ Frequently Asked Questions</h3>
            <p>Instant answers to top queries on legality, battery life, and speeds.</p>
            <p style="margin-top: 0.5rem;"><a href="/pages/faq">Browse Full FAQ →</a></p>
          </div>
          <div class="page-card">
            <h3>🔄 30-Day Returns</h3>
            <p>Review eligibility, authorization numbers, and refund steps.</p>
            <p style="margin-top: 0.5rem;"><a href="/pages/refund-policy">Read Return Policy →</a></p>
          </div>
          <div class="page-card">
            <h3>🛡️ 100-Day Warranty</h3>
            <p>Learn about motor, battery, and frame warranty coverage.</p>
            <p style="margin-top: 0.5rem;"><a href="/pages/refund-policy#warranty">Warranty Guidelines →</a></p>
          </div>
        </div>
      </section>

      <!-- Common Questions Accordion -->
      <section class="content-section">
        <h2>Common Questions Preview</h2>
        <div class="faq-accordion">
          <details class="faq-detail">
            <summary class="faq-summary">How long does shipping take?</summary>
            <div class="faq-answer">
              We offer 100% Free 7-Day Shipping to all 50 US States. Orders are dispatched from our warehouse in 24 to 48 hours, and a real-time carrier tracking number is emailed immediately upon handoff.
            </div>
          </details>

          <details class="faq-detail">
            <summary class="faq-summary">Is the Sur-Ron Light Bee X street legal?</summary>
            <div class="faq-answer">
              No. The 2026 Sur-Ron Light Bee X is engineered strictly as a high-performance off-road electric dirt bike for private property and designated OHV trails. It is not street legal for public roads in most jurisdictions.
            </div>
          </details>

          <details class="faq-detail">
            <summary class="faq-summary">What warranty is included?</summary>
            <div class="faq-answer">
              Every bike comes standard with our 100-Day Limited Warranty covering the electric drive motor, lithium battery pack, controller, and main aluminum alloy frame.
            </div>
          </details>

          <details class="faq-detail">
            <summary class="faq-summary">Do you offer financing?</summary>
            <div class="faq-answer">
              Yes! We offer monthly installment financing options at checkout through Shop Pay Installments, allowing you to split your purchase into manageable payments.
            </div>
          </details>
        </div>
        <p style="text-align: center; margin-top: 1rem;">
          <a href="/pages/faq" class="page-btn page-btn--outline-dark">View All Frequently Asked Questions →</a>
        </p>
      </section>

      <!-- Emergency Contact -->
      <div class="legal-notice-banner">
        <h3>🚨 Urgent Order or Delivery Support</h3>
        <p>If you need urgent assistance with an active shipment scheduled for delivery today, please email us with <strong>"URGENT: [Your Order Number]"</strong> in the subject line to <a href="mailto:contact@bikebee.shop?subject=URGENT%20ORDER%20ISSUE">contact@bikebee.shop</a>, and our dispatch desk will expedite priority review.</p>
      </div>

      <footer class="page-disclaimer">
        <p>This document is for informational purposes and does not constitute legal advice. &copy; {{ 'now' | date: '%Y' }} Bike Bee. All rights reserved.</p>
      </footer>
    </div>
  </div>
</article>
