<section class="final-cta-section full-width" id="order" aria-labelledby="FinalCtaHeading">
  <div class="final-cta__bg-container">
    <img
      src="{{ 'hero.jpg' | asset_url }}"
      alt="Sur-Ron Light Bee 2026 Background"
      class="final-cta__bg-img ken-burns"
      width="1920"
      height="1080"
      loading="lazy"
    >
    <div class="final-cta__overlay" style="background-color: rgba(11, 11, 12, {{ section.settings.overlay_opacity | default: 72 | divided_by: 100.0 }});"></div>
  </div>

  <div class="final-cta__container">
    <div class="final-cta__content text-center scroll-reveal">
      <span class="final-cta__eyebrow">LIMITED LAUNCH ALLOTMENT</span>
      <h2 id="FinalCtaHeading" class="final-cta__heading">
        {{ section.settings.heading | default: 'Your Decade Starts <span class="stroke">Now.</span>' }}
      </h2>
      <p class="final-cta__subtext">
        {{ section.settings.subtext | default: '20% off + free shipping during launch week only.' }}
      </p>

      <div class="final-cta__actions">
        <a href="{{ section.settings.cta_link | default: '#colors' }}" class="btn btn-accent-blue pill final-cta__btn">
          {{ section.settings.cta_text | default: 'Order My Light Bee' }}
        </a>
      </div>

      <div class="final-cta__perks">
        <span>⚡ Instant Dispatch</span>
        <span>✦</span>
        <span>🛡️ 100-Day Warranty</span>
        <span>✦</span>
        <span>↩️ 30-Day Trail Trial</span>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .final-cta-section {
    position: relative;
    padding: 9rem var(--page-margin, 20px);
    overflow: hidden;
    color: #FFFFFF;
    text-align: center;
  }

  .final-cta__bg-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .final-cta__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .final-cta__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .final-cta__container {
    position: relative;
    z-index: 2;
    max-width: 50rem;
    margin: 0 auto;
  }

  .final-cta__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .final-cta__eyebrow {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--color-accent-yellow, #FFD400);
    text-transform: uppercase;
  }

  .final-cta__heading {
    font-size: clamp(2.6rem, 5vw, 4.4rem);
    color: #FFFFFF;
    margin: 0;
    line-height: 1.05;
  }

  .final-cta__subtext {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    max-width: 36rem;
  }

  .final-cta__actions {
    margin-top: 0.75rem;
  }

  .final-cta__btn {
    padding: 1.1rem 2.8rem;
    font-size: 1.15rem;
    box-shadow: 0 10px 30px rgba(30, 144, 255, 0.4);
  }

  .final-cta__btn:hover {
    transform: scale(1.05);
    box-shadow: 0 16px 40px rgba(30, 144, 255, 0.55);
  }

  .final-cta__perks {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .final-cta-section {
      padding: 6rem var(--page-margin, 20px);
    }
    .final-cta__perks {
      gap: 0.5rem;
      font-size: 0.8rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Decade Starts <span class=\"stroke\">Now.</span>"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "20% off + free shipping during launch week only."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Order My Light Bee"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 40,
      "max": 90,
      "step": 1,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Final CTA"
    }
  ]
}
{% endschema %}
