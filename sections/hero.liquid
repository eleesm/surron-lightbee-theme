<section class="hero full-width" id="hero">
  <div class="hero__bg-container">
    {% if section.settings.hero_image != blank %}
      <img
        src="{{ section.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ section.settings.hero_image.alt | default: 'Sur-Ron Light Bee 2026 Hero Shot' }}"
        class="hero__bg-img ken-burns"
        loading="lazy"
        width="2000"
        height="2000"
      >
    {% elsif section.settings.image != blank %}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.image.alt | default: 'Sur-Ron Light Bee 2026 Hero Shot' }}"
        class="hero__bg-img ken-burns"
        loading="lazy"
        width="2000"
        height="2000"
      >
    {% else %}
      {{ 'hero.jpg' | asset_url | img_tag: 'Fallback', 'loading="lazy"' }}
    {% endif %}
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__container">
    <div class="hero__content" data-rv>
      <div class="hero__eyebrow">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span>{{ section.settings.eyebrow | default: 'THE 2026 LIGHT BEE' }}</span>
      </div>

      <h1 class="hero__title">
        <span class="hero__title-line">POWER UPGRADED.</span>
        <span class="hero__title-line"><span class="stroke">LIGHT</span> AS ALWAYS.</span>
      </h1>

      <p class="hero__subtext section-subtitle">
        {%- if section.settings.subtitle != blank -%}
          {%- if section.settings.subtitle contains 'The most powerful' -%}
            {{ section.settings.subtitle | replace: 'The most powerful', '<br class="hero__subtext-break">The most powerful' }}
          {%- else -%}
            {{ section.settings.subtitle }}
          {%- endif -%}
        {%- else -%}
          10kW of peak power. 59kg of pure control.<br class="hero__subtext-break">The most powerful Light Bee ever built &mdash; still light enough to lift.
        {%- endif -%}
      </p>

      <div class="hero__actions">
        <a href="#colors" class="btn btn-accent-blue pill hero__cta-primary">
          {{ section.settings.primary_cta_text | default: 'Choose Your Color' }}
        </a>
      </div>

      <div class="hero__chips">
        <div class="hero__chip floating-chip">
          <span class="chip-icon">⚡</span>
          <span class="chip-text">10kW PEAK</span>
        </div>
        <div class="hero__chip floating-chip">
          <span class="chip-icon">🪶</span>
          <span class="chip-text">59KG</span>
        </div>
        <div class="hero__chip floating-chip">
          <span class="chip-icon">🔋</span>
          <span class="chip-text">2.5kWh</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .shopify-section--hero {
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 7rem var(--page-margin, 20px) 4rem;
    margin-bottom: 0 !important;
  }

  .hero__bg-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(5, 8, 12, 0.75) 0%, rgba(5, 8, 12, 0.60) 50%, rgba(5, 8, 12, 0.75) 100%);
    pointer-events: none;
  }

  .hero__container {
    position: relative;
    z-index: 2;
    max-width: var(--page-width, 110rem);
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: flex-start;
  }

  .hero__content {
    width: 100%;
    max-width: 56rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 0.45rem 1.1rem;
    border-radius: var(--radius-pill, 999px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .hero__title {
    font-size: clamp(40px, 5.8vw, 104px);
    line-height: 1.02;
    margin: 0;
    color: #FFFFFF;
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.04em;
  }

  .hero__title-line {
    display: block;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .hero__title {
      font-size: clamp(26px, 8vw, 40px);
      line-height: 1.08;
    }
  }

  .hero__subtext {
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    width: 100%;
    max-width: 48rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
    font-family: var(--font-body, 'Inter', sans-serif);
    white-space: normal;
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .hero__subtext-break {
    display: inline;
  }

  @media (min-width: 768px) {
    .hero__subtext-break {
      display: block;
    }
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .hero__cta-primary {
    padding: 1rem 2.6rem;
    font-size: 1.05rem;
    background-color: var(--color-accent-blue, #1E90FF);
    color: #FFFFFF;
    box-shadow: 0 8px 24px rgba(30, 144, 255, 0.4);
  }

  .hero__chips {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.35rem;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-pill, 999px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    font-size: 0.95rem;
    color: #FFFFFF;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 6rem 1.25rem 3rem;
      min-height: 90vh;
    }
    .hero__content {
      align-items: flex-start;
      gap: 1.2rem;
    }
    .hero__title {
      font-size: clamp(38px, 11vw, 60px);
    }
    .hero__subtext {
      font-size: 1rem;
    }
    .hero__chips {
      gap: 0.5rem;
    }
    .hero__chip {
      padding: 0.5rem 0.9rem;
      font-size: 0.82rem;
    }
    .hero__actions {
      width: 100%;
    }
    .hero__cta-primary {
      width: 100%;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "class": "shopify-section--hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Background Image (Legacy)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE 2026 LIGHT BEE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Power Upgraded. <span class=\"stroke\">Light</span> As Always."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "10kW of peak power. 59kg of pure control. The most powerful Light Bee ever built — still light enough to lift."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Button Text",
      "default": "Choose Your Color"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
