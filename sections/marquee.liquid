<section class="marquee-section marquee full-width" id="marquee" aria-label="Highlights Marquee">
  <div class="marquee-wrapper">
    <div class="marquee-track">
      {% capture marquee_unit %}10kW PEAK POWER ✦ 59KG ✦ 2.5kWh ✦ 1.29s 0-30 ✦ FREE USA SHIPPING ✦ 100-DAY WARRANTY ✦ &nbsp;{% endcapture %}
      <div class="marquee-content">
        <span>{{ marquee_unit }}{{ marquee_unit }}{{ marquee_unit }}</span>
      </div>
      <div class="marquee-content" aria-hidden="true">
        <span>{{ marquee_unit }}{{ marquee_unit }}{{ marquee_unit }}</span>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .shopify-section--marquee {
    margin: 0 !important;
    padding: 0 !important;
  }

  .marquee-section,
  .marquee {
    position: relative;
    overflow: hidden;
    transform: none !important;
    margin: 0 !important;
    padding: 0 !important;
    z-index: 10;
  }

  .marquee-wrapper {
    background-color: var(--color-accent-yellow, #FFD400);
    transform: none !important;
    margin: 0 !important;
    padding: 1rem 0;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(255, 212, 0, 0.25);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: mq 24s linear infinite;
    will-change: transform;
  }

  .marquee-content {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .marquee-content span {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 2.2vw, 1.75rem);
    letter-spacing: -0.01em;
    color: #0B0B0C;
    display: inline-block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Marquee",
  "class": "shopify-section--marquee",
  "settings": [],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}
