<section class="marquee-section full-width" id="marquee" aria-label="Key Highlights">
  <div class="marquee-wrapper">
    <div class="marquee-track">
      {% assign marquee_text = section.settings.text | default: '10kW PEAK POWER ✦ 59KG ✦ 2.5kWh ✦ 1.29s 0-30 ✦ FREE USA SHIPPING ✦ 100-DAY WARRANTY ✦' %}
      <div class="marquee-content">
        <span>{{ marquee_text }}</span>
        <span>{{ marquee_text }}</span>
      </div>
      <div class="marquee-content" aria-hidden="true">
        <span>{{ marquee_text }}</span>
        <span>{{ marquee_text }}</span>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .marquee-section {
    position: relative;
    overflow: hidden;
    padding: 1.25rem 0;
    margin: 2rem 0;
    z-index: 10;
  }

  .marquee-wrapper {
    background-color: var(--color-accent-yellow, #FFD400);
    transform: rotate(-1.6deg) scale(1.03);
    padding: 1rem 0;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(255, 212, 0, 0.25);
  }

  .marquee-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    white-space: nowrap;
  }

  .marquee-content span {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 2.2vw, 1.75rem);
    letter-spacing: -0.01em;
    color: #0B0B0C;
    display: inline-block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Marquee Ticker",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Scrolling Text",
      "default": "10kW PEAK POWER ✦ 59KG ✦ 2.5kWh ✦ 1.29s 0-30 ✦ FREE USA SHIPPING ✦ 100-DAY WARRANTY ✦"
    }
  ],
  "presets": [
    {
      "name": "Marquee Ticker"
    }
  ]
}
{% endschema %}
