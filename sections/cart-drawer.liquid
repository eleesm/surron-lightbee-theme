{% comment %}
  Sur-Ron Light Bee 2026 - Premium Slide-Out Cart Drawer
  Asynchronous Cart UI with smooth transitions and Section Rendering API support.
{% endcomment %}

<div id="CartDrawerBackdrop" class="cart-drawer-backdrop" aria-hidden="true"></div>

<aside
  id="CartDrawer"
  class="cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Your Cart"
  aria-hidden="true"
>
  <span id="CartDrawerItemCount" data-item-count="{{ cart.item_count }}" style="display:none;" aria-hidden="true"></span>
  <div class="cart-drawer__inner">
    <!-- 1. Header -->
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Your Cart</h2>
      <button
        type="button"
        class="cart-drawer__close-btn"
        id="CartDrawerClose"
        aria-label="Close cart"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- 2. Scrollable Body: Cart Items or Empty State -->
    <div class="cart-drawer__body" id="CartDrawerBody">
      {%- if cart.item_count > 0 -%}
        <div class="cart-drawer__items" role="list">
          {%- for item in cart.items -%}
            <div class="cart-drawer__item" role="listitem" data-item-key="{{ item.key }}">
              <div class="cart-drawer__item-image-wrap">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 140, height: 140 }}"
                    alt="{{ item.title | escape }}"
                    class="cart-drawer__item-image"
                    width="64"
                    height="64"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="cart-drawer__item-image-placeholder">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}
              </div>

              <div class="cart-drawer__item-info">
                <a href="{{ item.url }}" class="cart-drawer__item-title">
                  {{ item.product.title }}
                </a>

                {%- unless item.product.has_only_default_variant -%}
                  <div class="cart-drawer__item-variant">
                    {{ item.variant.title }}
                  </div>
                {%- endunless -%}

                <div class="cart-drawer__item-price">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <span class="cart-drawer__item-price-current">{{ item.final_line_price | money }}</span>
                    <s class="cart-drawer__item-price-original">{{ item.original_line_price | money }}</s>
                  {%- else -%}
                    <span class="cart-drawer__item-price-current">{{ item.final_line_price | money }}</span>
                  {%- endif -%}
                </div>

                <div class="cart-drawer__item-actions">
                  <!-- Stepper: - 1 + -->
                  <div class="cart-drawer__stepper">
                    <button
                      type="button"
                      class="cart-drawer__stepper-btn cart-drawer__stepper-btn--minus"
                      data-item-key="{{ item.key }}"
                      data-quantity="{{ item.quantity | minus: 1 }}"
                      aria-label="Decrease quantity"
                    >
                      &minus;
                    </button>
                    <span class="cart-drawer__stepper-qty">{{ item.quantity }}</span>
                    <button
                      type="button"
                      class="cart-drawer__stepper-btn cart-drawer__stepper-btn--plus"
                      data-item-key="{{ item.key }}"
                      data-quantity="{{ item.quantity | plus: 1 }}"
                      aria-label="Increase quantity"
                    >
                      &#43;
                    </button>
                  </div>

                  <!-- Remove Item (Trash Icon) -->
                  <button
                    type="button"
                    class="cart-drawer__remove-btn"
                    data-item-key="{{ item.key }}"
                    aria-label="Remove {{ item.title }} from cart"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      <line x1="10" y1="11" x2="10" y2="17"></line>
                      <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <!-- Empty State -->
        <div class="cart-drawer__empty">
          <div class="cart-drawer__empty-icon" aria-hidden="true">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          </div>
          <p class="cart-drawer__empty-title">{{ section.settings.empty_title | default: 'Your cart is empty.' }}</p>
          <p class="cart-drawer__empty-subtitle">Ready to ride? Explore the 2026 Sur-Ron Light Bee lineup.</p>
          <button
            type="button"
            class="cart-drawer__continue-btn"
            id="CartDrawerContinue"
          >
            {{ section.settings.continue_shopping_text | default: 'Continue Shopping' }}
          </button>
        </div>
      {%- endif -%}
    </div>

    <!-- 3. Sticky Footer -->
    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer" id="CartDrawerFooter">
        <div class="cart-drawer__subtotal-row">
          <span class="cart-drawer__subtotal-label">Subtotal</span>
          <span class="cart-drawer__subtotal-price">{{ cart.total_price | money }}</span>
        </div>

        {%- if section.settings.show_taxes_notice -%}
          <p class="cart-drawer__tax-note">
            Shipping and taxes calculated at checkout.
          </p>
        {%- endif -%}

        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm">
          <button
            type="submit"
            name="checkout"
            class="cart-drawer__checkout-btn"
          >
            <span>CHECKOUT &mdash; {{ cart.total_price | money }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>

          {%- if additional_checkout_buttons -%}
            <div class="cart-drawer__dynamic-checkout">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}
        </form>
      </div>
    {%- endif -%}
  </div>
</aside>

{% stylesheet %}
  /* -------------------------------------------------------------
     Cart Drawer Overlay Backdrop
     ------------------------------------------------------------- */
  .cart-drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
  }

  body.cart-drawer-open .cart-drawer-backdrop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* -------------------------------------------------------------
     Cart Drawer Panel (420px width, max 90% on mobile)
     ------------------------------------------------------------- */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 420px;
    max-width: 90%;
    height: 100%;
    height: 100dvh;
    background-color: #FFFFFF;
    z-index: 1001;
    box-shadow: -12px 0 40px rgba(0, 0, 0, 0.18);
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    font-family: var(--font-body, 'Inter', sans-serif);
    color: var(--color-foreground, #0B0B0C);
  }

  body.cart-drawer-open .cart-drawer {
    transform: translateX(0);
  }

  body.cart-drawer-open {
    overflow: hidden;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  /* -------------------------------------------------------------
     Header: "Your Cart" (Archivo, italic, 900) + Close (X)
     ------------------------------------------------------------- */
  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 1.75rem;
    border-bottom: 1px solid rgba(11, 11, 12, 0.08);
    background-color: #FFFFFF;
    flex-shrink: 0;
  }

  .cart-drawer__title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    color: var(--color-foreground, #0B0B0C);
    margin: 0;
    line-height: 1;
  }

  .cart-drawer__close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-subtext, #61666D);
    padding: 6px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .cart-drawer__close-btn:hover {
    background-color: rgba(11, 11, 12, 0.06);
    color: var(--color-foreground, #0B0B0C);
    transform: scale(1.08);
  }

  /* -------------------------------------------------------------
     Cart Items List (Scrollable)
     ------------------------------------------------------------- */
  .cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 1.25rem 1.75rem;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cart-drawer__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(11, 11, 12, 0.06);
    position: relative;
  }

  .cart-drawer__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* 64px Thumbnail */
  .cart-drawer__item-image-wrap {
    width: 64px;
    height: 64px;
    min-width: 64px;
    border-radius: 10px;
    overflow: hidden;
    background-color: #F5F6F8;
    border: 1px solid rgba(11, 11, 12, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-drawer__item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-drawer__item-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-drawer__item-image-placeholder svg {
    width: 36px;
    height: 36px;
    opacity: 0.4;
  }

  .cart-drawer__item-info {
    flex: 1;
    min-width: 0;
  }

  .cart-drawer__item-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-foreground, #0B0B0C);
    text-decoration: none;
    display: block;
    margin: 0 0 0.2rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease;
  }

  .cart-drawer__item-title:hover {
    color: var(--color-accent-blue, #1E90FF);
  }

  .cart-drawer__item-variant {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-subtext, #61666D);
    margin-bottom: 0.35rem;
  }

  .cart-drawer__item-price {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-foreground, #0B0B0C);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cart-drawer__item-price-original {
    font-size: 0.82rem;
    color: var(--color-subtext, #61666D);
    text-decoration: line-through;
    font-weight: 400;
  }

  .cart-drawer__item-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  /* Stepper: - 1 + */
  .cart-drawer__stepper {
    display: inline-flex;
    align-items: center;
    background: #FFFFFF;
    border: 1px solid rgba(11, 11, 12, 0.12);
    border-radius: var(--radius-pill, 999px);
    height: 28px;
    padding: 0 2px;
  }

  .cart-drawer__stepper-btn {
    width: 24px;
    height: 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: var(--color-foreground, #0B0B0C);
    border-radius: 50%;
    transition: background-color 0.15s ease, color 0.15s ease;
    padding: 0;
  }

  .cart-drawer__stepper-btn:hover {
    background-color: rgba(11, 11, 12, 0.06);
    color: var(--color-accent-blue, #1E90FF);
  }

  .cart-drawer__stepper-qty {
    min-width: 24px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-foreground, #0B0B0C);
  }

  /* Trash Remove Button */
  .cart-drawer__remove-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-subtext, #61666D);
    padding: 6px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .cart-drawer__remove-btn:hover {
    color: #E53935;
    background-color: rgba(229, 57, 53, 0.08);
  }

  /* -------------------------------------------------------------
     Empty State
     ------------------------------------------------------------- */
  .cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    min-height: 320px;
    padding: 2rem 1rem;
  }

  .cart-drawer__empty-icon {
    color: var(--color-subtext, #61666D);
    margin-bottom: 1.25rem;
    opacity: 0.5;
  }

  .cart-drawer__empty-title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.4rem;
    color: var(--color-foreground, #0B0B0C);
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .cart-drawer__empty-subtitle {
    font-size: 0.9rem;
    color: var(--color-subtext, #61666D);
    margin: 0 0 1.75rem;
    max-width: 260px;
    line-height: 1.5;
  }

  .cart-drawer__continue-btn {
    background-color: var(--color-foreground, #0B0B0C);
    color: #FFFFFF;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-pill, 999px);
    border: none;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(11, 11, 12, 0.15);
  }

  .cart-drawer__continue-btn:hover {
    background-color: var(--color-accent-blue, #1E90FF);
    transform: scale(1.04);
    box-shadow: 0 6px 20px rgba(30, 144, 255, 0.35);
  }

  /* -------------------------------------------------------------
     Sticky Footer
     ------------------------------------------------------------- */
  .cart-drawer__footer {
    padding: 1.5rem 1.75rem;
    background-color: #FFFFFF;
    border-top: 1px solid rgba(11, 11, 12, 0.08);
    box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.04);
    flex-shrink: 0;
  }

  .cart-drawer__subtotal-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }

  .cart-drawer__subtotal-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-subtext, #61666D);
  }

  .cart-drawer__subtotal-price {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    font-size: 1.45rem;
    letter-spacing: -0.02em;
    color: var(--color-foreground, #0B0B0C);
  }

  .cart-drawer__tax-note {
    font-size: 0.8rem;
    color: var(--color-subtext, #61666D);
    margin: 0 0 1.25rem;
  }

  .cart-drawer__checkout-btn {
    width: 100%;
    background-color: var(--color-accent-blue, #1E90FF);
    color: #FFFFFF;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 1.1rem 1.5rem;
    border-radius: var(--radius-pill, 999px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    box-shadow: 0 8px 24px rgba(30, 144, 255, 0.35);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.2s ease;
  }

  .cart-drawer__checkout-btn:hover {
    background-color: #0077E6;
    transform: scale(1.02);
    box-shadow: 0 12px 30px rgba(30, 144, 255, 0.45);
  }

  .cart-drawer__checkout-btn:active {
    transform: scale(0.99);
  }

  .cart-drawer__dynamic-checkout {
    margin-top: 0.75rem;
  }

  .cart-drawer__dynamic-checkout [data-shopify-buttoncontainer] {
    border-radius: var(--radius-pill, 999px) !important;
    overflow: hidden;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_taxes_notice",
      "label": "Show taxes and shipping notice",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty Cart Title",
      "default": "Your cart is empty."
    },
    {
      "type": "text",
      "id": "continue_shopping_text",
      "label": "Continue Shopping Button Text",
      "default": "Continue Shopping"
    }
  ]
}
{% endschema %}
