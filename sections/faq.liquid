<section class="faq-section" id="faq" aria-labelledby="FaqHeading">
  <div class="faq__container">
    <div class="faq__header text-center scroll-reveal">
      <span class="faq__eyebrow">COMMON QUESTIONS</span>
      <h2 id="FaqHeading" class="faq__heading">
        {{ section.settings.heading | default: 'FAQ' }}
      </h2>
      <p class="faq__subtext subtext">
        Got questions about setup, delivery, or legality? We've got answers.
      </p>
    </div>

    <div class="faq__list scroll-reveal delay-1">
      <!-- Item 1 -->
      <div class="faq-item">
        <button type="button" class="faq-header" aria-expanded="false">
          <span class="faq-question">Is the Light Bee street legal?</span>
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-body">
          <div class="faq-content">
            <p>The Light Bee is designed for off-road use. Laws vary by state — check your local regulations before riding on public land.</p>
          </div>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="faq-item">
        <button type="button" class="faq-header" aria-expanded="false">
          <span class="faq-question">How fast does it ship?</span>
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-body">
          <div class="faq-content">
            <p>We ship free from our US warehouse. Delivery in about 7 business days.</p>
          </div>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="faq-item">
        <button type="button" class="faq-header" aria-expanded="false">
          <span class="faq-question">What if I don't love it?</span>
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-body">
          <div class="faq-content">
            <p>Ride it for 30 days. If it's not for you, send it back for a full refund.</p>
          </div>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="faq-item">
        <button type="button" class="faq-header" aria-expanded="false">
          <span class="faq-question">What does the warranty cover?</span>
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-body">
          <div class="faq-content">
            <p>100 days on the motor and battery, 30 days on all other components, plus US-based support.</p>
          </div>
        </div>
      </div>

      <!-- Item 5 -->
      <div class="faq-item">
        <button type="button" class="faq-header" aria-expanded="false">
          <span class="faq-question">Does it arrive assembled?</span>
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-body">
          <div class="faq-content">
            <p>85% pre-assembled. Most riders are on the trail within 30 minutes of unboxing.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .faq-section {
    padding: 6rem 0;
    background-color: var(--color-background, #F5F6F8);
    position: relative;
  }

  .faq__container {
    max-width: 50rem;
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }

  .faq__header {
    margin-bottom: 3.5rem;
    text-align: center;
  }

  .faq__eyebrow {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-accent-blue, #1E90FF);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }

  .faq__heading {
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    margin: 0 0 0.5rem;
    color: var(--color-foreground, #0B0B0C);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-item {
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid rgba(11, 11, 12, 0.06);
    overflow: hidden;
    transition: box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .faq-item.is-open {
    box-shadow: 0 16px 40px -10px rgba(11, 11, 12, 0.1);
    border-color: rgba(30, 144, 255, 0.3);
  }

  .faq-header {
    width: 100%;
    padding: 1.6rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-body, 'Inter', sans-serif);
    transition: background-color 0.2s ease;
  }

  .faq-header:hover {
    background-color: rgba(245, 246, 248, 0.5);
  }

  .faq-question {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-foreground, #0B0B0C);
    letter-spacing: -0.01em;
  }

  .faq-icon {
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-accent-blue, #1E90FF);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    line-height: 1;
  }

  .faq-item.is-open .faq-icon {
    transform: rotate(45deg);
  }

  .faq-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-content {
    padding: 0 2rem 1.6rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-subtext, #61666D);
  }

  .faq-content p {
    margin: 0;
  }

  @media (max-width: 640px) {
    .faq-header {
      padding: 1.25rem 1.5rem;
    }
    .faq-question {
      font-size: 1.05rem;
    }
    .faq-content {
      padding: 0 1.5rem 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
