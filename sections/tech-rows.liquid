<section class="tech-rows-section full-width" id="technology" aria-labelledby="TechRowsHeading">
  <div class="tech-rows__container">
    <div class="tech-rows__header text-center" data-rv>
      <h2 id="TechRowsHeading" class="tech-rows__heading">
        {{ section.settings.heading | default: 'Engineered To <span class="stroke">Dominate.</span>' }}
      </h2>
    </div>

    <div class="tech-rows__list">
      <!-- Row 1: Image Left, Text Right -->
      <article class="tech-row" data-rv>
        <div class="tech-row__media zoom-on-hover">
          {% if section.settings.motor_image != blank %}
            <img
              src="{{ section.settings.motor_image | image_url: width: 2000 }}"
              alt="{{ section.settings.motor_image.alt | default: '10kW Mid-Drive Motor' }}"
              class="tech-row__img"
              loading="lazy"
              width="2000"
              height="2000"
            >
          {% else %}
            <img
              src="{{ 'motor.jpg' | asset_url }}"
              alt="10kW Mid-Drive Motor"
              class="tech-row__img"
              loading="lazy"
              width="2000"
              height="2000"
            >
          {% endif %}
        </div>
        <div class="tech-row__content">
          <h3 class="tech-row__title">10kW Mid-Drive Motor</h3>
          <p class="tech-row__desc">
            295N&middot;m of torque. Peak power leapt from 8kW to 10kW. 38UH high-grade magnets shrug off 180&deg;C heat. Climb anything.
          </p>
        </div>
      </article>

      <!-- Row 2: Image Right, Text Left -->
      <article class="tech-row tech-row--reverse" data-rv>
        <div class="tech-row__media zoom-on-hover">
          {% if section.settings.battery_image != blank %}
            <img
              src="{{ section.settings.battery_image | image_url: width: 2000 }}"
              alt="{{ section.settings.battery_image.alt | default: '72V35Ah Battery — 2.5kWh' }}"
              class="tech-row__img"
              loading="lazy"
              width="2000"
              height="2000"
            >
          {% else %}
            <img
              src="{{ 'battery.jpg' | asset_url }}"
              alt="72V35Ah Battery — 2.5kWh"
              class="tech-row__img"
              loading="lazy"
              width="2000"
              height="2000"
            >
          {% endif %}
        </div>
        <div class="tech-row__content">
          <h3 class="tech-row__title">72V35Ah Battery — 2.5kWh</h3>
          <p class="tech-row__desc">
            50S high-rate cells with real-time monitoring on every cell. 10-second quick-swap. Charge anywhere, anytime. Stability over capacity.
          </p>
        </div>
      </article>

      <!-- Row 3: Image Left, Text Right -->
      <article class="tech-row" data-rv>
        <div class="tech-row__media zoom-on-hover">
          {% if section.settings.suspension_image != blank %}
            <img
              src="{{ section.settings.suspension_image | image_url: width: 2000 }}"
              alt="{{ section.settings.suspension_image.alt | default: 'Suspension Built For Landings' }}"
              class="tech-row__img"
              loading="lazy"
              width="2000"
              height="2000"
            >
          {% else %}
            <img
              src="{{ 'suspension.jpg' | asset_url }}"
              alt="Suspension Built For Landings"
              class="tech-row__img"
              loading="lazy"
              width="2000"
              height="2000"
            >
          {% endif %}
        </div>
        <div class="tech-row__content">
          <h3 class="tech-row__title">Suspension Built For Landings</h3>
          <p class="tech-row__desc">
            7.87" front travel, 10.51" fully adjustable rear shock with 450lbs alloy spring. Triple-rate springs: supple start, massive end support. Smooth landings, every time.
          </p>
        </div>
      </article>

      <!-- Row 4: Image Right, Text Left -->
      <article class="tech-row tech-row--reverse" data-rv>
        <div class="tech-row__media zoom-on-hover">
          {% if section.settings.wheelie_image != blank %}
            <img
              src="{{ section.settings.wheelie_image | image_url: width: 2000 }}"
              alt="{{ section.settings.wheelie_image.alt | default: 'All-New Wheelie Control' }}"
              class="tech-row__img"
              loading="lazy"
              width="2000"
              height="2000"
            >
          {% else %}
            <img
              src="{{ 'wheelie.jpg' | asset_url }}"
              alt="All-New Wheelie Control"
              class="tech-row__img"
              loading="lazy"
              width="2000"
              height="2000"
            >
          {% endif %}
        </div>
        <div class="tech-row__content">
          <h3 class="tech-row__title">All-New Wheelie Control</h3>
          <p class="tech-row__desc">
            Safe and free. Battery safety never compromised — millisecond-level cell monitoring with enhanced redundancy. Push your limits with a system that has your back.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
  .tech-rows-section {
    padding: 90px 0;
    background-color: #FFFFFF;
    position: relative;
  }

  .tech-rows__container {
    max-width: var(--page-width, 110rem);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }

  .tech-rows__header {
    margin-bottom: 4.5rem;
    text-align: center;
  }

  .tech-rows__heading {
    font-size: clamp(34px, 4.5vw, 56px);
    color: #0B0B0C;
    margin: 0;
  }

  .tech-rows__list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    max-width: 68rem;
    margin: 0 auto;
  }

  .tech-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: center;
  }

  .tech-row--reverse .tech-row__media {
    order: 2;
  }

  .tech-row--reverse .tech-row__content {
    order: 1;
  }

  .tech-row__media {
    border-radius: 28px;
    overflow: hidden;
    height: 300px;
    box-shadow: 0 14px 36px -8px rgba(11, 11, 12, 0.08);
  }

  .tech-row__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tech-row__media:hover .tech-row__img {
    transform: scale(1.07);
  }

  .tech-row__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tech-row__title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    font-size: 24px;
    color: #1E90FF;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .tech-row__desc {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 1.05rem;
    line-height: 1.65;
    color: #61666D;
    margin: 0;
  }

  @media (max-width: 768px) {
    .tech-rows-section {
      padding: 60px 0;
    }
    .tech-rows__list {
      gap: 3rem;
    }
    .tech-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .tech-row--reverse .tech-row__media {
      order: 1;
    }
    .tech-row--reverse .tech-row__content {
      order: 2;
    }
    .tech-row__media {
      height: 240px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tech Rows",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered To <span class=\"stroke\">Dominate.</span>"
    },
    {
      "type": "image_picker",
      "id": "motor_image",
      "label": "Motor Image"
    },
    {
      "type": "image_picker",
      "id": "battery_image",
      "label": "Battery Image"
    },
    {
      "type": "image_picker",
      "id": "suspension_image",
      "label": "Suspension Image"
    },
    {
      "type": "image_picker",
      "id": "wheelie_image",
      "label": "Wheelie Image"
    }
  ],
  "presets": [
    {
      "name": "Tech Rows"
    }
  ]
}
{% endschema %}
