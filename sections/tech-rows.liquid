<section class="tech-rows-section" id="technology" aria-labelledby="TechHeading">
  <div class="tech-rows__container">
    <div class="tech-rows__header text-center scroll-reveal">
      <span class="tech-rows__eyebrow">PRECISION ENGINEERING</span>
      <h2 id="TechHeading" class="tech-rows__heading">
        {{ section.settings.heading | default: 'Engineered To <span class="stroke">Dominate.</span>' }}
      </h2>
      <p class="tech-rows__subtext subtext">
        Every component re-designed from the molecular level up for high thermal tolerance and brutal trail endurance.
      </p>
    </div>

    <div class="tech-rows__list">
      <!-- Row 1: Motor -->
      <article class="tech-row scroll-reveal delay-1">
        <div class="tech-row__media zoom-on-hover">
          <img
            src="{{ 'motor.jpg' | asset_url }}"
            alt="10kW Mid-Drive Motor with 38UH High-Grade Magnets"
            class="tech-row__img"
            width="900"
            height="600"
            loading="lazy"
          >
          <div class="tech-row__badge">POWERTRAIN</div>
        </div>
        <div class="tech-row__content">
          <span class="tech-row__step">01 // TORQUE & DRIVE</span>
          <h3 class="tech-row__title">10kW Mid-Drive Motor</h3>
          <p class="tech-row__desc">
            295N&middot;m of torque. Peak power leapt from 8kW to 10kW. 38UH high-grade magnets shrug off 180&deg;C heat. Climb anything.
          </p>
          <ul class="tech-row__specs">
            <li><strong>295 N&middot;m</strong> Peak Torque</li>
            <li><strong>10,000 W</strong> Max Power Output</li>
            <li><strong>180&deg;C</strong> Thermal Resistance</li>
          </ul>
        </div>
      </article>

      <!-- Row 2: Battery (Reversed) -->
      <article class="tech-row tech-row--reverse scroll-reveal delay-2">
        <div class="tech-row__media zoom-on-hover">
          <img
            src="{{ 'battery.jpg' | asset_url }}"
            alt="72V35Ah Quick-Swap Battery"
            class="tech-row__img"
            width="900"
            height="600"
            loading="lazy"
          >
          <div class="tech-row__badge">ENERGY STORAGE</div>
        </div>
        <div class="tech-row__content">
          <span class="tech-row__step">02 // MODULAR POWER</span>
          <h3 class="tech-row__title">72V35Ah Battery — 2.5kWh</h3>
          <p class="tech-row__desc">
            50S high-rate cells with real-time monitoring on every cell. 10-second quick-swap. Charge anywhere, anytime. Stability over capacity.
          </p>
          <ul class="tech-row__specs">
            <li><strong>2.5 kWh</strong> Total Energy</li>
            <li><strong>50S</strong> High-Rate Cells</li>
            <li><strong>10s</strong> Tool-Free Quick Swap</li>
          </ul>
        </div>
      </article>

      <!-- Row 3: Suspension -->
      <article class="tech-row scroll-reveal delay-1">
        <div class="tech-row__media zoom-on-hover">
          <img
            src="{{ 'suspension.jpg' | asset_url }}"
            alt="Triple-Rate Spring Suspension"
            class="tech-row__img"
            width="900"
            height="600"
            loading="lazy"
          >
          <div class="tech-row__badge">CHASSIS & DAMPING</div>
        </div>
        <div class="tech-row__content">
          <span class="tech-row__step">03 // LANDING SUPPORT</span>
          <h3 class="tech-row__title">Suspension Built For Landings</h3>
          <p class="tech-row__desc">
            7.87" front travel, 10.51" fully adjustable rear shock with 450lbs alloy spring. Triple-rate springs: supple start, massive end support. Smooth landings, every time.
          </p>
          <ul class="tech-row__specs">
            <li><strong>7.87"</strong> Inverted Front Travel</li>
            <li><strong>10.51"</strong> Rear Multi-Link Shock</li>
            <li><strong>450 lbs</strong> High-Tensile Alloy Spring</li>
          </ul>
        </div>
      </article>

      <!-- Row 4: Wheelie Control (Reversed) -->
      <article class="tech-row tech-row--reverse scroll-reveal delay-2">
        <div class="tech-row__media zoom-on-hover">
          <img
            src="{{ 'wheelie.jpg' | asset_url }}"
            alt="Dynamic Wheelie and Traction Control"
            class="tech-row__img"
            width="900"
            height="600"
            loading="lazy"
          >
          <div class="tech-row__badge">SAFETY & ALGORITHMS</div>
        </div>
        <div class="tech-row__content">
          <span class="tech-row__step">04 // INTEL CONTROL</span>
          <h3 class="tech-row__title">All-New Wheelie Control</h3>
          <p class="tech-row__desc">
            Safe and free. Battery safety never compromised — millisecond-level cell monitoring with enhanced redundancy. Push your limits with a system that has your back.
          </p>
          <ul class="tech-row__specs">
            <li><strong>1ms</strong> Sampling Frequency</li>
            <li><strong>Dual</strong> Redundant Hall Sensors</li>
            <li><strong>Zero</strong> Battery Compromise</li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
  .tech-rows-section {
    padding: 6.5rem 0;
    background-color: var(--color-background, #F5F6F8);
    position: relative;
  }

  .tech-rows__container {
    max-width: var(--page-width, 110rem);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }

  .tech-rows__header {
    max-width: 44rem;
    margin: 0 auto 4.5rem;
  }

  .tech-rows__eyebrow {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-accent-blue, #1E90FF);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }

  .tech-rows__heading {
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    margin: 0 0 1rem;
    color: var(--color-foreground, #0B0B0C);
  }

  .tech-rows__list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .tech-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    background: #FFFFFF;
    border-radius: var(--radius-card, 32px);
    border: 1px solid rgba(11, 11, 12, 0.06);
    padding: 2.5rem;
    box-shadow: 0 12px 36px -10px rgba(11, 11, 12, 0.05);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tech-row:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 48px -12px rgba(11, 11, 12, 0.08);
  }

  .tech-row--reverse {
    direction: rtl;
  }

  .tech-row--reverse .tech-row__content {
    direction: ltr;
  }

  .tech-row__media {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    height: 380px;
  }

  .tech-row__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tech-row__badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    background: rgba(11, 11, 12, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #FFFFFF;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill, 999px);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .tech-row__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0;
  }

  .tech-row__step {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-accent-blue, #1E90FF);
  }

  .tech-row__title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    font-size: clamp(1.6rem, 2.5vw, 2.3rem);
    color: var(--color-foreground, #0B0B0C);
    margin: 0;
  }

  .tech-row__desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-subtext, #61666D);
    margin: 0;
  }

  .tech-row__specs {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    border-top: 1px solid rgba(11, 11, 12, 0.08);
    padding-top: 1.25rem;
  }

  .tech-row__specs li {
    font-size: 0.88rem;
    color: var(--color-subtext, #61666D);
    display: flex;
    flex-direction: column;
  }

  .tech-row__specs li strong {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    font-size: 1.2rem;
    color: var(--color-foreground, #0B0B0C);
  }

  @media (max-width: 880px) {
    .tech-row {
      grid-template-columns: 1fr;
      direction: ltr !important;
      padding: 1.5rem;
      gap: 1.75rem;
    }
    .tech-row__media {
      height: 260px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tech Rows",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered To <span class=\"stroke\">Dominate.</span>"
    }
  ],
  "presets": [
    {
      "name": "Tech Rows"
    }
  ]
}
{% endschema %}
