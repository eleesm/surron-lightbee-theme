<aside class="sticky-buy-bar" aria-label="Quick Purchase Bar">
  <div class="sticky-buy-bar__inner">
    <div class="sticky-buy-bar__product">
      <img
        src="{{ 'volt.jpg' | asset_url }}"
        alt="{{ product.title | default: 'Sur-Ron Light Bee 2026' }} Thumbnail"
        class="sticky-buy-bar__thumb"
        width="80"
        height="55"
        loading="lazy"
      >
      <div class="sticky-buy-bar__info">
        <span class="sticky-buy-bar__title">{{ product.title | default: 'Sur-Ron Light Bee 2026' }}</span>
        <span class="sticky-buy-bar__stock">⚡ In Stock — Ships in 24h</span>
      </div>
    </div>

    <div class="sticky-buy-bar__pricing">
      <span class="sticky-buy-bar__price-current">{{ product.price | default: 359900 | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="sticky-buy-bar__price-original">{{ product.compare_at_price | money }}</span>
      {%- elsif section.settings.compare_price != blank -%}
        <span class="sticky-buy-bar__price-original">{{ section.settings.compare_price }}</span>
      {%- endif -%}
    </div>

    <div class="sticky-buy-bar__action">
      <a href="{{ section.settings.cta_link | default: '#ProductForm' }}" class="btn btn-accent-blue pill sticky-buy-bar__btn">
        {{ section.settings.cta_text | default: 'Order Now' }}
      </a>
    </div>
  </div>
</aside>

{% stylesheet %}
  .sticky-buy-bar {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(120px);
    z-index: 990;
    width: calc(100% - 2rem);
    max-width: 44rem;
    background: rgba(11, 11, 12, 0.94);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-pill, 999px);
    padding: 0.75rem 1.25rem 0.75rem 1.5rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    opacity: 0;
    pointer-events: none;
  }

  .sticky-buy-bar.is-visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .sticky-buy-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .sticky-buy-bar__product {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .sticky-buy-bar__thumb {
    width: 50px;
    height: 35px;
    object-fit: cover;
    border-radius: 8px;
    background: #1A1A1E;
  }

  .sticky-buy-bar__info {
    display: flex;
    flex-direction: column;
  }

  .sticky-buy-bar__title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 0.95rem;
    color: #FFFFFF;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .sticky-buy-bar__stock {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.75rem;
    color: var(--color-accent-yellow, #FFD400);
    font-weight: 600;
  }

  .sticky-buy-bar__pricing {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .sticky-buy-bar__price-current {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-style: italic;
    font-weight: 900;
    font-size: 1.35rem;
    color: #FFFFFF;
  }

  .sticky-buy-bar__price-original {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: line-through;
  }

  .sticky-buy-bar__btn {
    padding: 0.65rem 1.6rem;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .sticky-buy-bar {
      bottom: 12px !important;
      left: 50% !important;
      transform: translateX(-50%) translateY(120px) !important;
      width: calc(100% - 24px) !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      padding: 10px 15px !important;
      border-radius: 18px !important;
      min-height: 60px !important;
      max-height: 70px !important;
      display: flex !important;
      align-items: center !important;
      overflow: hidden !important;
    }

    .sticky-buy-bar.is-visible {
      transform: translateX(-50%) translateY(0) !important;
    }

    .sticky-buy-bar__inner {
      width: 100% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 10px !important;
      box-sizing: border-box !important;
    }

    .sticky-buy-bar__product {
      display: flex !important;
      align-items: center !important;
      flex: 1 1 auto !important;
      min-width: 0 !important;
      gap: 0 !important;
    }

    .sticky-buy-bar__thumb,
    .sticky-buy-bar__stock {
      display: none !important;
    }

    .sticky-buy-bar__info {
      min-width: 0 !important;
      width: 100% !important;
    }

    .sticky-buy-bar__title {
      font-size: 12px !important;
      line-height: 1.25 !important;
      color: #FFFFFF !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      word-break: break-word !important;
      max-height: 2.5em !important;
      margin: 0 !important;
    }

    .sticky-buy-bar__pricing {
      flex: 0 0 auto !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      justify-content: center !important;
      gap: 1px !important;
      line-height: 1.1 !important;
    }

    .sticky-buy-bar__price-current {
      font-size: 14px !important;
      line-height: 1.1 !important;
      color: #FFFFFF !important;
      white-space: nowrap !important;
      font-family: var(--font-heading, 'Archivo', sans-serif) !important;
      font-weight: 900 !important;
    }

    .sticky-buy-bar__price-original {
      font-size: 11px !important;
      line-height: 1 !important;
      color: rgba(255, 255, 255, 0.5) !important;
      white-space: nowrap !important;
      text-decoration: line-through !important;
      font-family: var(--font-body, 'Inter', sans-serif) !important;
    }

    .sticky-buy-bar__action {
      flex: 0 0 auto !important;
      display: flex !important;
      align-items: center !important;
    }

    .sticky-buy-bar__btn {
      padding: 10px 16px !important;
      font-size: 12px !important;
      font-weight: 700 !important;
      white-space: nowrap !important;
      flex-shrink: 0 !important;
      line-height: 1 !important;
      border-radius: 999px !important;
      box-sizing: border-box !important;
      background-color: var(--color-accent-blue, #1E90FF) !important;
      color: #FFFFFF !important;
      box-shadow: 0 4px 12px rgba(30, 144, 255, 0.3) !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticky Buy Bar",
  "settings": [
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$3,599"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare Price",
      "default": "$4,499"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Sticky Buy Bar"
    }
  ]
}
{% endschema %}
