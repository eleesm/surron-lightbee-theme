<footer class="footer full-width">
  <div class="footer__inner">
    <div class="footer__disclaimer">
      <span class="footer__disclaimer-badge">Notice</span>
      <p class="footer__disclaimer-text">For off-road use only. Not street legal.</p>
    </div>

    <div class="footer__content">
      <div class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} Bike Bee. All rights reserved.
      </div>

      {% if section.settings.menu != blank %}
        <nav class="footer__links" aria-label="Footer Navigation">
          {% for link in section.settings.menu.links %}
            {{ link.title | link_to: link.url }}
          {% endfor %}
        </nav>
      {% endif %}

      <div class="footer__payment">
        {% if section.settings.show_payment_icons %}
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .shopify-section--footer,
  .shopify-section:has(.footer) {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    grid-column: 1 / -1 !important;
    display: block !important;
  }

  .footer {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    margin-top: auto !important;
    padding: 3rem 0 2rem !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    grid-column: 1 / -1 !important;
    border-top: 1px solid rgba(11, 11, 12, 0.08);
    background-color: var(--color-background, #F5F6F8);
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  .footer__inner {
    max-width: var(--page-width, 110rem);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer__disclaimer {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    background-color: rgba(11, 11, 12, 0.03);
    border: 1px solid rgba(11, 11, 12, 0.08);
    border-radius: var(--radius-pill, 999px);
    width: fit-content;
  }

  .footer__disclaimer-badge {
    background-color: var(--color-accent-yellow, #FFD400);
    color: #0B0B0C;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill, 999px);
  }

  .footer__disclaimer-text {
    color: var(--color-subtext, #61666D);
    font-size: 0.85rem;
    font-weight: 500;
    margin: 0;
  }

  .footer__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(11, 11, 12, 0.04);
  }

  .footer__copyright {
    color: var(--color-subtext, #61666D);
    font-size: 0.875rem;
  }

  .footer__links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer__links a {
    text-decoration: none;
    color: var(--color-subtext, #61666D);
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .footer__links a:hover {
    color: var(--color-accent-blue, #1E90FF);
  }

  .footer__payment {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__payment svg {
    height: 1.5rem;
  }

  @media (max-width: 768px) {
    .footer__inner {
      padding: 0 12px !important;
    }
    .footer__content {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .footer__disclaimer {
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      align-items: center !important;
      justify-content: flex-start !important;
      padding: 6px 10px !important;
      gap: 7px !important;
      border-radius: 999px !important;
    }
    .footer__disclaimer-badge {
      flex: 0 0 auto !important;
      flex-shrink: 0 !important;
      font-size: 9.5px !important;
      font-weight: 800 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.04em !important;
      padding: 2.5px 7px !important;
      border-radius: 999px !important;
      line-height: 1.1 !important;
      display: inline-flex !important;
      align-items: center !important;
      margin: 0 !important;
    }
    .footer__disclaimer-text {
      font-size: clamp(10.5px, 2.9vw, 11.5px) !important;
      font-weight: 500 !important;
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      margin: 0 !important;
      line-height: 1.2 !important;
      flex: 1 1 auto !important;
      min-width: 0 !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "class": "shopify-section--footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
